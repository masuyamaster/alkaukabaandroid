<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.AlKaukaba" >
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
    </style>
<!--    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />-->
<!--    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />-->

    <!-- Tombol grid Kalkulator Scientific (2026-09) -->
    <style name="CalcKeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcKeyNumber" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_number</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKeyOp" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_op</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKeyFunction" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_function</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CalcKeyConst" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_const</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKeyAction" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_action</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKeyParen" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_paren</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKeyMode" parent="CalcKeyBase">
        <item name="android:background">@drawable/bg_calc_key_mode</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>