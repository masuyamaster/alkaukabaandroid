<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card_up_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus Akun"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/pill_red_text"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tindakan ini permanen. Semua data akun (termasuk pengaturan lokasi &amp; preferensi tersimpan) akan dihapus dan tidak bisa dikembalikan."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masukkan kata sandi untuk konfirmasi"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etDeleteConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_outline"
            android:inputType="textPassword"
            android:hint="Kata sandi"
            android:layout_marginBottom="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hapus Akun Saya"
            android:background="@drawable/bg_btn_main_dark"
            android:backgroundTint="@color/pill_red_text"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
