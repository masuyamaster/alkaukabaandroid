<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_home_warm"
    tools:context=".ui.gerhana.GerhanaActivity">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_toolbar_default" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_gradient_navy">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:alpha="0.85"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/gold_accent"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="60dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.6"
            android:background="@drawable/dot_star"
            android:backgroundTint="@color/gold_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gis_location_poi"
                app:tint="@color/gold_accent"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvLocationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Mendeteksi lokasi..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_dark"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btnRefreshLoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟳ Ubah Lokasi"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTabBulan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_underline_active_navy"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Gerhana Bulan"
            android:textColor="@color/text_label_gold"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnTabMatahari"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_underline_inactive"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Gerhana Matahari"
            android:textColor="@color/waktu_sholat_icon_muted"
            android:textStyle="normal"
            android:textSize="14sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/gold_accent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLunarEclipse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            tools:listitem="@layout/item_gerhana_bulan"
            tools:itemCount="3" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSolarEclipse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone"
            tools:listitem="@layout/item_gerhana_matahari"
            tools:itemCount="3" />

    </FrameLayout>

</LinearLayout>
