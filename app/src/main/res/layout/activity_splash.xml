<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    tools:context=".Splashscreen">

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="60dp"
        android:alpha="0.8"
        android:background="@drawable/dot_star"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="50dp"
        android:alpha="0.6"
        android:background="@drawable/dot_star"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="150dp"
        android:alpha="0.8"
        android:background="@drawable/dot_star"
        android:backgroundTint="@color/gold_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="190dp"
        android:layout_marginEnd="34dp"
        android:alpha="0.7"
        android:background="@drawable/dot_star"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="76dp"
        android:alpha="0.9"
        android:src="@drawable/ic_sparkle"
        app:tint="@color/gold_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="34dp"
        android:alpha="0.65"
        android:background="@drawable/dot_star"
        android:backgroundTint="@color/gold_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.32" />

    <View
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginEnd="52dp"
        android:alpha="0.6"
        android:background="@drawable/dot_star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.55" />

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_al_kaukaba_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/dotsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_star"
            android:backgroundTint="@color/gold_accent" />

        <View
            android:id="@+id/dot2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_star"
            android:backgroundTint="@color/gold_accent" />

        <View
            android:id="@+id/dot3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_star"
            android:backgroundTint="@color/gold_accent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
