<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_home_warm"
    tools:context=".ui.zakat.ZakatActivity">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_toolbar_default" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutZakat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/icon_emerald"
        app:tabIndicatorColor="@color/icon_emerald"
        app:tabMaxWidth="0dp"
        app:tabGravity="fill"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fitrah" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mal (Harta)" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profesi" />

    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- ===== Tab 1: Zakat Fitrah ===== -->
            <LinearLayout
                android:id="@+id/layoutFitrah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zakat fitrah wajib bagi setiap jiwa muslim menjelang Idul Fitri, sebesar 2.5 kg beras (atau nilai uang setaranya) per jiwa."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah Jiwa"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etJumlahJiwa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:inputType="number"
                    android:hint="cth: 4"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harga Beras per Kg (Rp)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etHargaBeras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:inputType="number"
                    android:hint="cth: 13000"
                    android:layout_marginBottom="20dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHitungFitrah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hitung Zakat Fitrah"
                    android:background="@drawable/bg_btn_main_dark"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="20dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHasilFitrah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hasil Perhitungan"
                            android:textColor="@color/text_label_gold"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tvHasilFitrahBeras"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="Total beras: 10 kg (4 jiwa x 2.5 kg)" />

                        <TextView
                            android:id="@+id/tvHasilFitrahUang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Rp 130.000" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ===== Tab 2: Zakat Mal ===== -->
            <LinearLayout
                android:id="@+id/layoutMal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/includeHargaEmasMal"
                    layout="@layout/view_harga_emas" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Zakat mal wajib bila harta yang disimpan minimal 1 tahun (haul) mencapai nisab 85 gram emas, sebesar 2.5% dari harta bersih."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Harta (Rp)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etTotalHarta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:inputType="number"
                    android:hint="cth: 50000000"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Hutang (Rp) - opsional"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etTotalHutangMal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:inputType="number"
                    android:hint="cth: 0"
                    android:layout_marginBottom="20dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHitungMal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hitung Zakat Mal"
                    android:background="@drawable/bg_btn_main_dark"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="20dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHasilMal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hasil Perhitungan"
                            android:textColor="@color/text_label_gold"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tvHasilMalNisab"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="Nisab (85 gr emas): Rp 42.500.000" />

                        <TextView
                            android:id="@+id/tvHasilMalStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="Harta bersih Rp 50.000.000 sudah mencapai nisab - wajib zakat" />

                        <TextView
                            android:id="@+id/tvHasilMalJumlah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Rp 1.250.000" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ===== Tab 3: Zakat Profesi ===== -->
            <LinearLayout
                android:id="@+id/layoutProfesi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/includeHargaEmasProfesi"
                    layout="@layout/view_harga_emas" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Zakat profesi dihitung dari total penghasilan setahun, sebesar 2.5% bila totalnya mencapai nisab 85 gram emas (metode akumulasi tahunan)."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Penghasilan Setahun (Rp)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etPenghasilanSetahun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:inputType="number"
                    android:hint="cth: 120000000"
                    android:layout_marginBottom="20dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHitungProfesi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hitung Zakat Profesi"
                    android:background="@drawable/bg_btn_main_dark"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="20dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHasilProfesi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hasil Perhitungan"
                            android:textColor="@color/text_label_gold"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tvHasilProfesiNisab"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="Nisab (85 gr emas): Rp 42.500.000" />

                        <TextView
                            android:id="@+id/tvHasilProfesiStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="Penghasilan Rp 120.000.000 sudah mencapai nisab - wajib zakat" />

                        <TextView
                            android:id="@+id/tvHasilProfesiJumlah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Rp 3.000.000" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>
