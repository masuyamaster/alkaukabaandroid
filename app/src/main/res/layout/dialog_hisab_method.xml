<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card_up_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Metode Hisab Awal Bulan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp"/>

        <RadioGroup
            android:id="@+id/radioGroupHisabMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioHisabAstronomyEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Astronomy Engine\nEphemeris modern (io.github.cosinekitty.astronomy), kriteria Neo-MABIMS"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <RadioButton
                android:id="@+id/radioHisabDurrulAniq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ad-Durrul Aniq\nKitab hisab klasik (Ahmad Ghozali Muhammad Fathulloh), kriteria Neo-MABIMS"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
        </RadioGroup>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveHisabMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Simpan"
            android:background="@drawable/bg_btn_main_dark"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
