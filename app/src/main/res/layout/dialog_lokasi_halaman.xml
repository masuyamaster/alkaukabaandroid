<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card_up_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokasi untuk Halaman Ini"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <RadioGroup
            android:id="@+id/radioGroupPageLocationMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioPageLocationGlobal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ikuti pengaturan global\nPakai lokasi yang sama dengan Konfigurasi (GPS/manual)"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <RadioButton
                android:id="@+id/radioPageLocationManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual khusus halaman ini\nTidak mengubah pengaturan lokasi global"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layoutPageManualLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lintang (Latitude)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etPageManualLat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_outline"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:hint="-6.9822"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bujur (Longitude)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etPageManualLng"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_outline"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:hint="112.6304"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPageUseCurrentGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📍 Pakai lokasi GPS saat ini"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input_outline"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPagePickFromMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🗺️ Pilih dari peta"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input_outline"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSavePageLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan"
            android:background="@drawable/bg_btn_main_dark"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
