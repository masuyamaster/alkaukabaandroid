<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_up_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tema Aplikasi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Latar gelap lebih nyaman di mata saat dibuka malam hari atau Subuh."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/layoutThemeOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_toggle_container"
        android:padding="4dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvThemeLight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="Terang"
            android:textColor="@color/text_unselected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvThemeDark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="Gelap"
            android:textColor="@color/text_unselected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvThemeSystem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="Ikuti Sistem"
            android:textColor="@color/text_unselected"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTutupThemeSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selesai"
        android:background="@drawable/bg_btn_main_dark"
        android:textColor="@android:color/white" />

</LinearLayout>
