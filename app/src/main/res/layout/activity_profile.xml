<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_home_warm"
    tools:context=".ui.profile.ProfileActivity">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_toolbar_default" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= A. INFORMASI AKUN (hero, tanpa kotak besar) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="16dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:padding="36dp"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="@color/gold_accent"
                        android:src="@drawable/ic_person"
                        android:scaleType="centerCrop"
                        app:tint="@color/login_bg_deep"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name" />

                    <ImageView
                        android:id="@+id/ivAvatarBadge"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-4dp"
                        android:layout_marginBottom="-4dp"
                        android:padding="14dp"
                        android:background="@drawable/bg_avatar_badge"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/gold_accent"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Ubah foto profil" />

                    <FrameLayout
                        android:id="@+id/avatarUploadScrim"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:background="@drawable/bg_avatar_scrim"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/gold_accent" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/loading"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/loading"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="24dp"
                    android:text="Edit Profil"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/text_label_gold"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawablePadding="8dp"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"
                    android:background="@drawable/bg_pill_navy_light" />

            </LinearLayout>

            <!-- ================= C. BANTUAN & INFORMASI ================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BANTUAN &amp; INFORMASI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_label_gold"
                android:letterSpacing="0.05"
                android:paddingHorizontal="4dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="@color/card_white"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/rowHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_menu_support"
                        app:tint="@color/text_label_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hubungi Kami / Bantuan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="@color/text_hint" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="@color/divider_soft" />

                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_menu_document"
                        app:tint="@color/text_label_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kebijakan Privasi &amp; Syarat Ketentuan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="@color/text_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= D. KEAMANAN & TINDAKAN AKUN ================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KEAMANAN &amp; AKUN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_label_gold"
                android:letterSpacing="0.05"
                android:paddingHorizontal="4dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/rowChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="@color/card_white"
                android:layout_marginBottom="28dp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_menu_lock"
                    app:tint="@color/text_label_gold"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ubah Kata Sandi"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_btn_outline_danger"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:gravity="center"
                    android:text="Keluar (Logout)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/pill_red_text" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="24dp"
                    android:src="@drawable/ic_logout"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/rowDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/pill_red_text"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hapus Akun secara permanen"
                    android:textSize="13sp"
                    android:textColor="@color/pill_red_text" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
