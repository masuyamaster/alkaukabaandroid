<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card_up_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profil"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp"/>

        <FrameLayout
            android:id="@+id/avatarContainerSheet"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivAvatarSheet"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:padding="18dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="@color/gold_accent"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop"
                app:tint="@color/login_bg_deep"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/ivAvatarBadgeSheet"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-2dp"
                android:layout_marginBottom="-2dp"
                android:padding="6dp"
                android:background="@drawable/bg_avatar_badge_on_white"
                android:src="@drawable/ic_camera"
                app:tint="@color/gold_accent"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ubah foto profil" />

            <FrameLayout
                android:id="@+id/avatarUploadScrimSheet"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_avatar_scrim"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/gold_accent" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Pengguna"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etProfileUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_outline"
            android:inputType="textPersonName"
            android:hint="Nama Pengguna"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email tidak bisa diubah di sini. Hubungi Bantuan kalau perlu ganti email."
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan"
            android:background="@drawable/bg_btn_main_dark"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
