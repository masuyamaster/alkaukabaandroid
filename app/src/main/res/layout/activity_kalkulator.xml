<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_home_warm"
    tools:context=".ui.kalkulator.KalkulatorActivity">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_toolbar_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="start"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            tools:text="sin(30)+2×(3−1)" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:weightSum="8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btnModeAngle"
                style="@style/CalcKeyMode"
                android:text="DEG" />

            <TextView
                android:id="@+id/btnClear"
                style="@style/CalcKeyAction"
                android:text="AC" />

            <TextView
                android:id="@+id/btnBackspace"
                style="@style/CalcKeyAction"
                android:text="⌫" />

            <TextView
                android:id="@+id/btnPercent"
                style="@style/CalcKeyOp"
                android:text="%" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btnSin"
                style="@style/CalcKeyFunction"
                android:text="sin" />

            <TextView
                android:id="@+id/btnCos"
                style="@style/CalcKeyFunction"
                android:text="cos" />

            <TextView
                android:id="@+id/btnTan"
                style="@style/CalcKeyFunction"
                android:text="tan" />

            <TextView
                android:id="@+id/btnDivide"
                style="@style/CalcKeyOp"
                android:text="÷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btnLn"
                style="@style/CalcKeyFunction"
                android:text="ln" />

            <TextView
                android:id="@+id/btnLog"
                style="@style/CalcKeyFunction"
                android:text="log" />

            <TextView
                android:id="@+id/btnSqrt"
                style="@style/CalcKeyFunction"
                android:text="√" />

            <TextView
                android:id="@+id/btnMultiply"
                style="@style/CalcKeyOp"
                android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btnOpenParen"
                style="@style/CalcKeyParen"
                android:text="(" />

            <TextView
                android:id="@+id/btnCloseParen"
                style="@style/CalcKeyParen"
                android:text=")" />

            <TextView
                android:id="@+id/btnPower"
                style="@style/CalcKeyOp"
                android:text="^" />

            <TextView
                android:id="@+id/btnMinus"
                style="@style/CalcKeyOp"
                android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btn7"
                style="@style/CalcKeyNumber"
                android:text="7" />

            <TextView
                android:id="@+id/btn8"
                style="@style/CalcKeyNumber"
                android:text="8" />

            <TextView
                android:id="@+id/btn9"
                style="@style/CalcKeyNumber"
                android:text="9" />

            <TextView
                android:id="@+id/btnPlus"
                style="@style/CalcKeyOp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btn4"
                style="@style/CalcKeyNumber"
                android:text="4" />

            <TextView
                android:id="@+id/btn5"
                style="@style/CalcKeyNumber"
                android:text="5" />

            <TextView
                android:id="@+id/btn6"
                style="@style/CalcKeyNumber"
                android:text="6" />

            <TextView
                android:id="@+id/btnPi"
                style="@style/CalcKeyConst"
                android:text="π" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btn1"
                style="@style/CalcKeyNumber"
                android:text="1" />

            <TextView
                android:id="@+id/btn2"
                style="@style/CalcKeyNumber"
                android:text="2" />

            <TextView
                android:id="@+id/btn3"
                style="@style/CalcKeyNumber"
                android:text="3" />

            <TextView
                android:id="@+id/btnEuler"
                style="@style/CalcKeyConst"
                android:text="e" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btn0"
                style="@style/CalcKeyNumber"
                android:layout_weight="2"
                android:text="0" />

            <TextView
                android:id="@+id/btnDot"
                style="@style/CalcKeyNumber"
                android:text="." />

            <TextView
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_gold"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="="
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
