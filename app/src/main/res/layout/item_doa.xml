<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNomor"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="@color/bg_green_light"
            android:gravity="center"
            android:textColor="@color/icon_green"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1" />

        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Ayat al-Kursi" />

        <TextView
            android:id="@+id/tvTeksArab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="22sp"
            android:lineSpacingMultiplier="1.6"
            tools:text="اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ" />

        <TextView
            android:id="@+id/tvTeksLatin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="italic"
            tools:text="Allāhu lā ilāha illā huwalḥayyul qayyụm..." />

        <TextView
            android:id="@+id/tvTerjemahan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            tools:text="Allah, tidak ada Tuhan (yang berhak disembah) melainkan Dia..." />

        <TextView
            android:id="@+id/tvCatatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_yellow"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/icon_yellow"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Dibaca 1x" />

        <TextView
            android:id="@+id/tvFawaid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/bg_gold_light"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.2"
            tools:text="Barang siapa yang membaca ayat ini ketika pagi, maka ia akan dilindungi hingga petang." />

        <TextView
            android:id="@+id/tvSumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            tools:text="HR. at-Tirmidzi: 2879" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
