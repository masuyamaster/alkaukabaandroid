<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    tools:context=".ui.arahkiblat.KiblatActivity">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_toolbar_default"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/includeToolbar"
        app:layout_constraintBottom_toTopOf="@id/infoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgCompassDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_compass_dial_modern"
            android:contentDescription="Qibla Compass" />

        <ImageView
            android:id="@+id/imgCompassNeedle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_qibla_needle"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/calibrationHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/bg_calibration_hint"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kalibrasiHint"
                android:textSize="12sp"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </FrameLayout>

    <!-- ================= INFO CARD (biru dongker, konsisten dengan Hero Card Waktu Sholat) ================= -->
    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/waktu_sholat_dark_bg"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtQiblaLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sudutKiblat"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/waktu_sholat_pill_text"/>

            <TextView
                android:id="@+id/btnQiblaDetail"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="ⓘ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/waktu_sholat_pill_text"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtQiblaValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="294°"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#332D3748"/>

        <LinearLayout
            android:id="@+id/locationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location_kiblat"
                app:tint="@color/waktu_sholat_pill_text" />

            <TextView
                android:id="@+id/txtLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Kecamatan Sukomanunggal, Indonesia"
                android:textColor="@color/waktu_sholat_pill_text"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>