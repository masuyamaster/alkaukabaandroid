<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAyat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNomorAyat"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="@color/gold_accent"
                android:gravity="center"
                android:textColor="@color/navy_dongker"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="1" />

            <ImageView
                android:id="@+id/btnPlayAyat"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_circle_outline_gold"
                android:padding="9dp"
                android:src="@drawable/ic_play"
                app:tint="@color/gold_accent"
                android:contentDescription="@string/quran_play_ayat" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvTeksArab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="24sp"
            android:lineSpacingMultiplier="1.6"
            tools:text="بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ" />

        <TextView
            android:id="@+id/tvTeksLatin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="italic"
            tools:text="Bismillāhir-raḥmānir-raḥīm(i)." />

        <TextView
            android:id="@+id/tvTeksIndonesia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            tools:text="Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang." />

    </LinearLayout>
</androidx.cardview.widget.CardView>
